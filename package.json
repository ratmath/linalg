{
  "name": "@ratmath/linalg",
  "version": "0.1.0",
  "description": "Exact rational linear algebra with fast float previews that sharpen to exact answers",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./worker": "./src/worker.js",
    "./teach": "./src/teach/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "docs/llms.txt",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test ./tests",
    "docs:build": "bun scripts/build-docs.js && node scripts/build-llms.mjs",
    "docs:llms": "node scripts/build-llms.mjs"
  },
  "keywords": [
    "rational",
    "exact",
    "linear-algebra",
    "matrix",
    "determinant",
    "bareiss",
    "progressive"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/linalg.git"
  },
  "homepage": "https://ratmath.com/linalg/",
  "dependencies": {
    "@ratmath/algebraic": "^0.1.0"
  },
  "peerDependencies": {
    "@ratmath/core": ">=0.10.0 <0.12.0"
  },
  "types": "index.d.ts",
  "workspaces": [
    "vendor/algebraic"
  ],
  "devDependencies": {
    "@ratmath/core": "^0.11.0",
    "katex": "0.19.1"
  },
  "author": "James Taylor",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/ratmath/linalg/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
